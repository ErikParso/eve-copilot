# Keep the build context small and avoid shipping stale/host-specific artifacts.
# Dependencies are reinstalled in the image via `npm ci`; models are baked in-image.
**/node_modules
**/dist
.git
.gitignore
# Never bake local secrets into the image (dev-only; HF injects secrets at runtime)
**/.env
**/.env.*
*.wav
graphify-out
graphify-out/**
**/*.log
