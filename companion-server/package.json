{
  "name": "eve-companion-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone AI companion backend: local Ollama (text) + Kokoro TTS (voice) behind POST /api/companion/react.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --max-old-space-size=1536 dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "kokoro-js": "^1.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.43",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5"
  }
}
